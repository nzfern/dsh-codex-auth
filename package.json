{
  "name": "dsh-codex-auth",
  "version": "0.1.0",
  "description": "ChatGPT (Codex) OAuth login and access-token keep-alive for the DeepSeek Harness: use your ChatGPT Plus/Pro/Team/Enterprise quota through the openai-codex provider",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "bin": {
    "dsh-codex-login": "bin/codex-login.mjs",
    "dsh-codex-status": "bin/codex-status.mjs",
